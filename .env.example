# Google AI (Gemini) — AI Scanner chart analysis + lot sizing
# Get key from https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_api_key_here

# Render: proxy auth/DB to NexTrade Lightsail (read-only from local dev)
API_UPSTREAM_URL=https://nextradeai.io

# Gmail SMTP (Render /api/send-email relay — use a Google App Password)
GMAIL_USER=nextradeaiapp@gmail.com
GMAIL_PASS=your_gmail_app_password
GMAIL_FROM_NAME=NexTradeAI
AURAAI_EMAIL_RELAY_SECRET=generate-with-openssl-rand-hex-24

# Chart warmup (idle poll → AI scan → trade). Off for NexTrade production.
EXPO_PUBLIC_CHART_WARMUP_ENABLED=false
