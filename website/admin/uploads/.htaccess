# Allow the Aura web/PWA (Render) to fetch brand images for notification icons.
# Without ACAO, Safari blocks fetch() from https://aura-ai-app.onrender.com.
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Range"
  Header set Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^(.*)$ $1 [R=204,L]
</IfModule>
