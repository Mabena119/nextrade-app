{
  "expo": {
    "name": "NexTradeAI",
    "slug": "nextrade-ai",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "auraai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "statusBar": {
      "style": "light",
      "backgroundColor": "#000000",
      "translucent": false
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.auraai.app",
      "statusBar": {
        "style": "light",
        "backgroundColor": "#000000",
        "translucent": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSExceptionDomains": {
            "trade.mql5.com": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2",
              "NSExceptionRequiresForwardSecrecy": false
            },
            "metatraderweb.app": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2",
              "NSExceptionRequiresForwardSecrecy": false
            },
            "webtrader.razormarkets.co.za": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2",
              "NSExceptionRequiresForwardSecrecy": false
            },
            "webtrading.atfxafrica.com": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2",
              "NSExceptionRequiresForwardSecrecy": false
            },
            "webtrader.spacemarkets.io": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2",
              "NSExceptionRequiresForwardSecrecy": false
            },
            "webtrader.trade245.com": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2",
              "NSExceptionRequiresForwardSecrecy": false
            },
            "rcgmarkets.com": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2",
              "NSExceptionRequiresForwardSecrecy": false
            }
          }
        }
      }
    },
    "android": {
      "versionCode": 24,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "app.auraai.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "statusBar": {
        "style": "light",
        "backgroundColor": "#000000",
        "translucent": false
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "name": "NexTradeAI",
      "shortName": "NexTradeAI",
      "startUrl": "/",
      "display": "standalone",
      "orientation": "portrait",
      "themeColor": "#00A8FF",
      "backgroundColor": "#000000",
      "description": "NexTradeAI",
      "scope": "/",
      "lang": "en",
      "categories": [
        "finance",
        "business",
        "productivity"
      ],
      "icons": [
        {
          "src": "./assets/images/icon.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any maskable"
        },
        {
          "src": "./assets/images/adaptive-icon.png",
          "sizes": "512x512",
          "type": "image/png",
          "purpose": "any maskable"
        }
      ],
      "screenshots": [
        {
          "src": "./assets/images/icon.png",
          "sizes": "1280x720",
          "type": "image/png",
          "formFactor": "wide"
        }
      ],
      "relatedApplications": []
    },
    "plugins": [
      "expo-router",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-video",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow NexTradeAI to use motion sensors for the holographic Matrix theme."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_API_BASE_URL": "https://nextrade-app-uklj.onrender.com",
      "EXPO_PUBLIC_NATIVE_API_BASE_URL": "https://nextrade-app-uklj.onrender.com",
      "EXPO_PUBLIC_CHART_WARMUP_ENABLED": false,
      "router": {}
    },
    "owner": "justvino"
  }
}
